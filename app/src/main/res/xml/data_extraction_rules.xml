<?xml version="1.0" encoding="utf-8"?>
<!-- Spec visitas §4.2-9 (H15, E-APP-073): reglas de Android 12+ (API 31+).
     La base de Room nunca se respalda ni se transfiere: restaurarla resucitaría
     pendientes o la base de otro cobrador en un teléfono reasignado. Excluir el
     dominio `database` deja fuera todo `databases/` (msp_db, la cola de
     telemetría y la caché local de Firestore).
     Las marcas de visitas solo valen junto a la base que las escribió: sin ella,
     `visitas_poda` dejaría podar resguardadas que este teléfono no reportó.
     Tarea 14 (visitas P1, E-VIS-029): `visitas_telemetria` es lo último que este
     aparato mandó de visitas_estado; en otro aparato no significa nada.
     P2 Tarea 15 (E-APP-097): `visitas_capacidades` es el contrato que anunció
     el servidor al que habla ESTE aparato; restaurada en otro, con su marca de
     refresco, mandaría campos que su servidor podría rechazar. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="visitas_poda.xml"/>
        <exclude domain="sharedpref" path="visitas_conciliacion_ultima.xml"/>
        <exclude domain="sharedpref" path="visitas_telemetria.xml"/>
        <exclude domain="sharedpref" path="visitas_capacidades.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="visitas_poda.xml"/>
        <exclude domain="sharedpref" path="visitas_conciliacion_ultima.xml"/>
        <exclude domain="sharedpref" path="visitas_telemetria.xml"/>
        <exclude domain="sharedpref" path="visitas_capacidades.xml"/>
    </device-transfer>
</data-extraction-rules>
